   ],
   "source": [
    "gcj_lon = float(106.6071869) #输入经度\n",
    "gcj_lat = float(38.63838895) #输入纬度\n",
    "transformer = Transformer.from_crs(\"EPSG:4326\", \"EPSG:4490\")\n",
    "cgcs_lon, cgcs_lat = transformer.transform(gcj_lon, gcj_lat)\n",
    "print(cgcs_lon, cgcs_lat)"
   ]
